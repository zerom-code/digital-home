# ─────────────────────────────────────────────────────────────────────────────
# Переменные КЛИЕНТА (попадают в бандл — здесь не должно быть ничего секретного)
# ─────────────────────────────────────────────────────────────────────────────

# URL проекта Supabase, например https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Публичный anon-ключ Supabase. Он публичный по замыслу: доступ к данным
# ограничивает Row Level Security, а не секретность ключа.
VITE_SUPABASE_ANON_KEY=

# Базовый адрес приложения — нужен для ссылок-приглашений и QR-наклеек
VITE_APP_URL=http://localhost:5173

# Публичный VAPID-ключ для web push (приватный живёт только на сервере)
VITE_VAPID_PUBLIC_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# СЕРВЕРНЫЕ СЕКРЕТЫ — НЕ ПРЕФИКС VITE_, НЕ В .env КЛИЕНТА
#
# Эти значения задаются только в секретах Supabase Edge Functions:
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# Перечислены здесь как документация, а не для локального заполнения.
# ─────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=            # ключ OpenAI для ai-* функций (§9 плана)
# SUPABASE_SERVICE_ROLE_KEY= # выдаётся Supabase автоматически внутри функций
# VAPID_PRIVATE_KEY=         # приватная часть пары для web push
# VAPID_SUBJECT=             # mailto:... для web push
