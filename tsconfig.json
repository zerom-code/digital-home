{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // types задан явно, поэтому @types/node сюда нужно вписать руками —
    // иначе tsc не увидит node:url в vite.config.ts
    "types": ["node", "vite/client", "vite-plugin-pwa/react", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts"],
  // Service worker живёт в окружении WebWorker: его lib конфликтует с DOM,
  // поэтому он проверяется отдельным tsconfig.worker.json
  "exclude": ["src/sw.ts"]
}
